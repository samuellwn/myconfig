# @ !os:systemd
# @ !user:dracowizard
# @ !install:644:$HOME/.config/systemd/user/wayvnc@.service
[Unit]
Description=A VNC server for wlroots based Wayland compositors
After=wayland-wm@hyprland.desktop.service
After=wayland-wm@hyprland.service

[Service]
Type=simple
ExecStart=/usr/bin/wayvnc -g -R -o %i
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=wayland-wm@hyprland.desktop.service
WantedBy=wayland-wm@hyprland.service
